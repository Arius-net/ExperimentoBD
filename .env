# =============================================================================
# .env - Parametrización del experimento MongoDB vs PostgreSQL JSONB
# Valores activos: PROFILE_A_BASELINE.
# run_benchmarks.sh exportará las variables del perfil correspondiente; las
# variables exportadas en el shell tienen prioridad sobre este archivo.
# =============================================================================

# --- Imágenes (versiones fijas por reproducibilidad) -------------------------
MONGO_IMAGE=mongo:7.0
POSTGRES_IMAGE=postgres:16

# --- Perfil de contención activo (cgroups v2) --------------------------------
# PROFILE_A_BASELINE | PROFILE_B_MEDIUM | PROFILE_C_SEVERE
PROFILE_NAME=PROFILE_A_BASELINE
CPU_LIMIT=4.0
MEM_LIMIT=4096m
MEMSWAP_LIMIT=4096m          # igual a MEM_LIMIT => 0 swap

# --- Tuning interno proporcional a la memoria del perfil ---------------------
MONGO_WT_CACHE_GB=2          # ~50% de MEM_LIMIT
PG_SHARED_BUFFERS=1GB        # 25% de MEM_LIMIT
PG_EFFECTIVE_CACHE_SIZE=2GB  # ~50% de MEM_LIMIT
PG_WORK_MEM=64MB             # fijo en todos los perfiles (Q2 lo variará por sesión con SET work_mem)

# --- Referencia: valores de los otros perfiles (no activos) ------------------
# PROFILE_B_MEDIUM:
#   PROFILE_NAME=PROFILE_B_MEDIUM  CPU_LIMIT=2.0  MEM_LIMIT=2048m  MEMSWAP_LIMIT=2048m
#   MONGO_WT_CACHE_GB=1  PG_SHARED_BUFFERS=512MB  PG_EFFECTIVE_CACHE_SIZE=1GB
# PROFILE_C_SEVERE:
#   PROFILE_NAME=PROFILE_C_SEVERE  CPU_LIMIT=1.0  MEM_LIMIT=1024m  MEMSWAP_LIMIT=1024m
#   MONGO_WT_CACHE_GB=0.5  PG_SHARED_BUFFERS=256MB  PG_EFFECTIVE_CACHE_SIZE=512MB

# --- Credenciales y puertos (entorno local de benchmark) ---------------------
POSTGRES_USER=bench
POSTGRES_PASSWORD=bench_pass
POSTGRES_DB=benchdb
MONGO_PORT=27017
POSTGRES_PORT=5432
PROMETHEUS_PORT=9090
CADVISOR_PORT=8080
NODE_EXPORTER_PORT=9100
